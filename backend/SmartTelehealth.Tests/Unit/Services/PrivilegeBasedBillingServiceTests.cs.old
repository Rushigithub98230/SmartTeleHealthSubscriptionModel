    #region ProcessSubscriptionRenewalAsync Tests

    [Fact]
    public async Task ProcessSubscriptionRenewalAsync_WithPendingOverage_ReturnsError()
    {
        // Arrange
        var subscriptionId = Guid.NewGuid();
        var tokenModel = _fixture.Create<TokenModel>();

        var subscription = new Subscription
        {
            Id = subscriptionId,
            UserId = 1,
            Status = Subscription.SubscriptionStatuses.Active
        };

        var pendingOverage = new List<BillingRecord>
        {
            new BillingRecord
            {
                Id = Guid.NewGuid(),
                UserId = 1,
                Type = BillingRecord.BillingType.Overage,
                Status = BillingRecord.BillingStatus.Pending,
                TotalAmount = 50.00m
            }
        };

        _subscriptionRepositoryMock
            .Setup(x => x.GetByIdWithDetailsAsync(subscriptionId))
            .ReturnsAsync(subscription);

        _billingRepositoryMock
            .Setup(x => x.GetByUserIdAsync(1))
            .ReturnsAsync(pendingOverage);

        // Act
        var result = await _service.ProcessSubscriptionRenewalAsync(subscriptionId, tokenModel);

        // Assert
        result.Should().NotBeNull();
        result.StatusCode.Should().Be(400);
        result.Message.Should().Contain("pending overage charges");
    }

    [Fact]
    public async Task ProcessSubscriptionRenewalAsync_ValidRenewal_ResetsUsageAndUpdatesSubscription()
    {
        // Arrange
        var subscriptionId = Guid.NewGuid();
        var tokenModel = _fixture.Create<TokenModel>();

        var subscription = new Subscription
        {
            Id = subscriptionId,
            UserId = 1,
            Status = Subscription.SubscriptionStatuses.Active,
            NextBillingDate = DateTime.UtcNow
        };

        var privilegeUsages = new List<UserSubscriptionPrivilegeUsage>
        {
            new UserSubscriptionPrivilegeUsage
            {
                Id = Guid.NewGuid(),
                SubscriptionId = subscriptionId,
                UsedValue = 5
            },
            new UserSubscriptionPrivilegeUsage
            {
                Id = Guid.NewGuid(),
                SubscriptionId = subscriptionId,
                UsedValue = 3
            }
        };

        _subscriptionRepositoryMock
            .Setup(x => x.GetByIdWithDetailsAsync(subscriptionId))
            .ReturnsAsync(subscription);

        _billingRepositoryMock
            .Setup(x => x.GetByUserIdAsync(1))
            .ReturnsAsync(new List<BillingRecord>());

        _privilegeUsageRepositoryMock
            .Setup(x => x.GetByUserIdAsync(1))
            .ReturnsAsync(privilegeUsages);

        _unitOfWorkMock.Setup(x => x.BeginTransactionAsync()).Returns(Task.CompletedTask);
        _unitOfWorkMock.Setup(x => x.CommitTransactionAsync()).Returns(Task.CompletedTask);

        // Act
        var result = await _service.ProcessSubscriptionRenewalAsync(subscriptionId, tokenModel);

        // Assert
        result.Should().NotBeNull();
        result.StatusCode.Should().Be(200);
        result.Message.Should().Contain("successfully");

        // Verify usage reset
        foreach (var usage in privilegeUsages)
        {
            usage.UsedValue.Should().Be(0);
            usage.ResetAt.Should().BeCloseTo(DateTime.UtcNow, TimeSpan.FromSeconds(5));
        }

        _unitOfWorkMock.Verify(x => x.CommitTransactionAsync(), Times.Once);
    }

    #endregion

