    [Fact]
    public async Task CalculatePlanBasePriceAsync_WithInvalidPlan_ReturnsError()
    {
        // Arrange
        var planId = Guid.NewGuid();
        var calculateDto = new CalculatePlanPriceDto { PlanId = planId };
        var tokenModel = _fixture.Create<TokenModel>();

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetByIdWithDetailsAsync(planId))
            .ReturnsAsync((SubscriptionPlan)null);

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetPlanPrivilegesAsync(planId))
            .ReturnsAsync(new List<SubscriptionPlanPrivilege>());

        // Act
        var result = await _service.CalculatePlanBasePriceAsync(calculateDto, tokenModel);

        // Assert
        result.Should().NotBeNull();
        result.StatusCode.Should().Be(404);
        result.Message.Should().Contain("Subscription plan not found");
    }

