    #region Error Handling Tests

    [Fact]
    public async Task CalculatePlanBasePriceAsync_RepositoryException_ReturnsError()
    {
        // Arrange
        var planId = Guid.NewGuid();
        var calculateDto = new CalculatePlanPriceDto { PlanId = planId };
        var tokenModel = _fixture.Create<TokenModel>();

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetByIdWithDetailsAsync(planId))
            .ThrowsAsync(new Exception("Database error"));

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetPlanPrivilegesAsync(planId))
            .ThrowsAsync(new Exception("Database error"));

        // Act
        var result = await _service.CalculatePlanBasePriceAsync(calculateDto, tokenModel);

        // Assert
        result.Should().NotBeNull();
        result.StatusCode.Should().Be(500);
        result.Message.Should().Contain("Error");
    }

    [Fact]
    public async Task ProcessPrivilegeUsageAsync_TransactionFailure_RollsBack()
    {
        // Arrange
        var usageDto = new ProcessPrivilegeUsageDto
        {
            UserId = 1,
            PrivilegeId = Guid.NewGuid(),
            UsageCount = 1
        };

        var tokenModel = _fixture.Create<TokenModel>();

        var subscription = new Subscription
        {
            Id = Guid.NewGuid(),
            UserId = 1,
            SubscriptionPlanId = Guid.NewGuid(),
            BillingCycleId = Guid.NewGuid(),
            Status = Subscription.SubscriptionStatuses.Active
        };

        var privilegeUsage = new UserSubscriptionPrivilegeUsage
        {
            Id = Guid.NewGuid(),
            SubscriptionId = subscription.Id,
            PrivilegeId = usageDto.PrivilegeId,
            UsedValue = 0
        };

        var planPrivilege = new SubscriptionPlanPrivilege
        {
            Id = Guid.NewGuid(),
            SubscriptionPlanId = subscription.SubscriptionPlanId,
            PrivilegeId = usageDto.PrivilegeId,
            DailyLimit = 10,
            UnitCost = 5.00m
        };

        _subscriptionRepositoryMock
            .Setup(x => x.GetActiveSubscriptionByUserIdAsync(usageDto.UserId))
            .ReturnsAsync(subscription);

        _privilegeUsageRepositoryMock
            .Setup(x => x.GetByUserAndPrivilegeAsync(usageDto.UserId, usageDto.PrivilegeId))
            .ReturnsAsync(privilegeUsage);

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetPlanPrivilegeAsync(subscription.SubscriptionPlanId, usageDto.PrivilegeId))
            .ReturnsAsync(planPrivilege);

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetByIdWithDetailsAsync(planPrivilege.SubscriptionPlanId))
            .ReturnsAsync(new SubscriptionPlan
            {
                Id = planPrivilege.SubscriptionPlanId,
                BillingCycle = new MasterBillingCycle { Name = "Monthly" }
            });

        _privilegeUsageRepositoryMock
            .Setup(x => x.UpdatePrivilegeUsageAsync(It.IsAny<UserSubscriptionPrivilegeUsage>()))
            .ReturnsAsync(privilegeUsage);

        _unitOfWorkMock.Setup(x => x.BeginTransactionAsync()).Returns(Task.CompletedTask);
        _unitOfWorkMock.Setup(x => x.CommitTransactionAsync()).ThrowsAsync(new Exception("Commit failed"));
        _unitOfWorkMock.Setup(x => x.RollbackTransactionAsync()).Returns(Task.CompletedTask);

        // Act & Assert
        await Assert.ThrowsAsync<Exception>(() => 
            _service.ProcessPrivilegeUsageAsync(usageDto, tokenModel));

        _unitOfWorkMock.Verify(x => x.RollbackTransactionAsync(), Times.Once);
    }

    #endregion
