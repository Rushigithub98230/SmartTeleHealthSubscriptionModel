    #region CalculatePlanBasePriceAsync Tests

    [Fact]
    public async Task CalculatePlanBasePriceAsync_WithValidPlan_ReturnsCorrectPrice()
    {
        // Arrange
        var planId = Guid.NewGuid();
        var calculateDto = new CalculatePlanPriceDto
        {
            PlanId = planId,
            AdminCommissionPercentage = 10
        };

        var tokenModel = _fixture.Create<TokenModel>();

        var subscriptionPlan = new SubscriptionPlan
        {
            Id = planId,
            Name = "Test Plan",
            Description = "Test Plan Description",
            Price = 100.00m,
            IsActive = true
        };

        var planPrivileges = new List<SubscriptionPlanPrivilege>
        {
            new SubscriptionPlanPrivilege
            {
                Id = Guid.NewGuid(),
                SubscriptionPlanId = planId,
                PrivilegeId = Guid.NewGuid(),
                DailyLimit = 10,
                UnitCost = 5.00m
            },
            new SubscriptionPlanPrivilege
            {
                Id = Guid.NewGuid(),
                SubscriptionPlanId = planId,
                PrivilegeId = Guid.NewGuid(),
                DailyLimit = 5,
                UnitCost = 10.00m
            }
        };

        var privileges = new List<Privilege>
        {
            new Privilege { Id = planPrivileges[0].PrivilegeId, Name = "Consultation" },
            new Privilege { Id = planPrivileges[1].PrivilegeId, Name = "Medication" }
        };

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetByIdWithDetailsAsync(planId))
            .ReturnsAsync(subscriptionPlan);

        _subscriptionPlanRepositoryMock
            .Setup(x => x.GetPlanPrivilegesAsync(planId))
            .ReturnsAsync(planPrivileges);

        _privilegeRepositoryMock
            .Setup(x => x.GetByIdsAsync(It.IsAny<IEnumerable<Guid>>()))
            .ReturnsAsync(privileges);

        // Act
        var result = await _service.CalculatePlanBasePriceAsync(calculateDto, tokenModel);

        // Assert
        result.Should().NotBeNull();
        result.StatusCode.Should().Be(200);
        result.data.Should().NotBeNull();

        // Verify base price calculation: (10 * 5.00) + (5 * 10.00) = 50 + 50 = 100
        // Commission: 100 * 0.10 = 10
        // Total: 100 + 10 = 110
    }

